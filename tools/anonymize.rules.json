{
  "version": "1.7",
  "_comment": "Общий (публичный) слой правил обезличивания. Только машинно-независимое: переменные окружения, структурные шаблоны путей, политика projects, список непубликуемых файлов. Личные имена, организации и специфичные пути — в tools/anonymize.local.json (он в .gitignore).",
  "scan": ["memory-design", "reference", "lessons", "project", "system", "system-prompt", "README.md", "MIGRATION.md", "CHANGELOG.md"],
  "home_placeholder": "~",
  "env_paths": [
    { "env": "MEMORY_DIR", "placeholder": "$MEMORY_DIR" },
    { "env": "LETTA_TRANSCRIPT_ROOT", "default": "~/.letta/transcripts", "placeholder": "$LETTA_TRANSCRIPT_ROOT" },
    { "env": "LETTA_LOCAL_BACKEND_DIR", "default": "~/.letta/lc-local-backend", "placeholder": "$LETTA_LOCAL_BACKEND_DIR" },
    { "env": "TEMP", "placeholder": "<temp dir>" }
  ],
  "regex_replacements": [
    ["([A-Za-z]:\\\\Users\\\\|/home/|/Users/)(?!<)[^\\\\/\\s]+", "\\1<username>"],
    ["(^|[.!?]\\s+)пользовател", "\\1Пользовател"]
  ],
  "projects": {
    "dir": "project",
    "service_dir": "reference",
    "keep_as_examples": ["environment-compass"],
    "index_template": "tools/templates/index.json"
  },
  "core_templates": {
    "system/persona.md": "memory-design/templates/persona.md",
    "system/human.md": "memory-design/templates/human.md"
  },
  "local_files": [],
  "forbidden_patterns": [
    "[A-Za-z]:\\\\Users\\\\(?!<)[^\\\\\\s]+",
    "(?:/home/|/Users/)(?!<)[^\\s/]+"
  ]
}